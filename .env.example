# Aplicación
APP_NAME="Sistema de Agenda Clínica"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT="development"

# Base de datos
DATABASE_URL="sqlite:///./agenda_clinica.db"
# Para PostgreSQL:
# DATABASE_URL="postgresql://user:password@localhost:5432/agenda_clinica"
DB_ECHO=false

# Seguridad
SECRET_KEY="CHANGE-THIS-SECRET-KEY-IN-PRODUCTION-USE-LONG-RANDOM-STRING"
JWT_ALGORITHM="HS256"
JWT_EXPIRATION_HOURS=8
BCRYPT_ROUNDS=12

# CORS
CORS_ORIGINS='["http://localhost:3000","http://localhost:8080"]'

# API
API_PREFIX="/api/v1"
DOCS_ENABLED=true

# Machine Learning
ENABLE_ML_SCORING=false
ML_MODELS_PATH="./models"
ML_RETRAIN_INTERVAL_DAYS=7

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"
LOG_FILE=""

# Redis (opcional)
REDIS_URL=""
CACHE_TTL_SECONDS=3600

# Alertas
ALERTAS_PREVENTIVAS_DIAS=7

# Paginación
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=1000
