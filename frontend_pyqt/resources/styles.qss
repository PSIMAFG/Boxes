/* Estilos Globales - Sistema de Agenda Clínica */

/* Widget Principal */
QWidget {
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
    background-color: #f5f5f5;
    color: #333;
}

/* Ventanas y Diálogos */
QMainWindow, QDialog {
    background-color: #ffffff;
}

/* Botones */
QPushButton {
    background-color: #2196F3;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: bold;
    min-height: 30px;
}

QPushButton:hover {
    background-color: #1976D2;
}

QPushButton:pressed {
    background-color: #0D47A1;
}

QPushButton:disabled {
    background-color: #BDBDBD;
    color: #757575;
}

QPushButton[type="secondary"] {
    background-color: #757575;
}

QPushButton[type="secondary"]:hover {
    background-color: #616161;
}

QPushButton[type="success"] {
    background-color: #4CAF50;
}

QPushButton[type="success"]:hover {
    background-color: #388E3C;
}

QPushButton[type="danger"] {
    background-color: #F44336;
}

QPushButton[type="danger"]:hover {
    background-color: #D32F2F;
}

/* Campos de texto */
QLineEdit, QTextEdit, QPlainTextEdit {
    border: 1px solid #BDBDBD;
    border-radius: 4px;
    padding: 8px;
    background-color: white;
    selection-background-color: #2196F3;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 2px solid #2196F3;
}

QLineEdit:disabled, QTextEdit:disabled, QPlainTextEdit:disabled {
    background-color: #F5F5F5;
    color: #9E9E9E;
}

/* ComboBox */
QComboBox {
    border: 1px solid #BDBDBD;
    border-radius: 4px;
    padding: 6px;
    background-color: white;
    min-height: 30px;
}

QComboBox:focus {
    border: 2px solid #2196F3;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: url(down_arrow.png);
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    border: 1px solid #BDBDBD;
    background-color: white;
    selection-background-color: #2196F3;
}

/* Tablas */
QTableWidget, QTableView {
    border: 1px solid #E0E0E0;
    background-color: white;
    alternate-background-color: #FAFAFA;
    selection-background-color: #BBDEFB;
    selection-color: #000;
    gridline-color: #E0E0E0;
}

QTableWidget::item, QTableView::item {
    padding: 5px;
}

QHeaderView::section {
    background-color: #2196F3;
    color: white;
    padding: 8px;
    border: none;
    font-weight: bold;
}

/* Labels */
QLabel {
    color: #333;
}

QLabel[type="title"] {
    font-size: 16pt;
    font-weight: bold;
    color: #2196F3;
}

QLabel[type="subtitle"] {
    font-size: 12pt;
    font-weight: bold;
    color: #555;
}

QLabel[type="error"] {
    color: #F44336;
    font-size: 9pt;
}

/* CheckBox */
QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #BDBDBD;
    border-radius: 3px;
    background-color: white;
}

QCheckBox::indicator:checked {
    background-color: #2196F3;
    border-color: #2196F3;
}

QCheckBox::indicator:hover {
    border-color: #2196F3;
}

/* RadioButton */
QRadioButton {
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #BDBDBD;
    border-radius: 9px;
    background-color: white;
}

QRadioButton::indicator:checked {
    background-color: #2196F3;
    border-color: #2196F3;
}

/* Tabs */
QTabWidget::pane {
    border: 1px solid #E0E0E0;
    background-color: white;
}

QTabBar::tab {
    background-color: #F5F5F5;
    border: 1px solid #E0E0E0;
    padding: 8px 16px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: white;
    border-bottom-color: white;
    font-weight: bold;
    color: #2196F3;
}

QTabBar::tab:hover {
    background-color: #EEEEEE;
}

/* MenuBar */
QMenuBar {
    background-color: #2196F3;
    color: white;
    padding: 4px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 8px 12px;
}

QMenuBar::item:selected {
    background-color: #1976D2;
}

QMenu {
    background-color: white;
    border: 1px solid #E0E0E0;
}

QMenu::item {
    padding: 8px 24px;
}

QMenu::item:selected {
    background-color: #BBDEFB;
}

/* ToolBar */
QToolBar {
    background-color: #2196F3;
    border: none;
    spacing: 4px;
    padding: 4px;
}

QToolButton {
    background-color: transparent;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px;
}

QToolButton:hover {
    background-color: #1976D2;
}

QToolButton:pressed {
    background-color: #0D47A1;
}

/* ListWidget */
QListWidget {
    border: 1px solid #E0E0E0;
    background-color: white;
    outline: none;
}

QListWidget::item {
    padding: 10px;
    border-bottom: 1px solid #F0F0F0;
}

QListWidget::item:selected {
    background-color: #BBDEFB;
    color: #000;
}

QListWidget::item:hover {
    background-color: #E3F2FD;
}

/* ScrollBar */
QScrollBar:vertical {
    border: none;
    background-color: #F5F5F5;
    width: 12px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #BDBDBD;
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background-color: #9E9E9E;
}

QScrollBar:horizontal {
    border: none;
    background-color: #F5F5F5;
    height: 12px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #BDBDBD;
    border-radius: 6px;
    min-width: 20px;
}

/* GroupBox */
QGroupBox {
    border: 2px solid #E0E0E0;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 12px;
    font-weight: bold;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 8px;
    color: #2196F3;
}

/* ProgressBar */
QProgressBar {
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    text-align: center;
    background-color: #F5F5F5;
}

QProgressBar::chunk {
    background-color: #2196F3;
    border-radius: 3px;
}

/* StatusBar */
QStatusBar {
    background-color: #F5F5F5;
    border-top: 1px solid #E0E0E0;
}
