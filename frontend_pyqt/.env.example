# Configuración del Frontend PyQt6 - Sistema de Agenda Clínica

# URL del Backend FastAPI
API_BASE_URL=http://localhost:8000

# Configuración de la aplicación
APP_NAME="Sistema de Agenda Clínica"
APP_VERSION="1.0.0"

# Timeout para requests HTTP (segundos)
REQUEST_TIMEOUT=30

# Archivo de persistencia de sesión (cifrado)
SESSION_FILE=.session.enc

# Clave para cifrado local de sesión (cambiar en producción)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your-generated-key-here
